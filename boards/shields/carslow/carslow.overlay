#include <dt-bindings/zmk/matrix_transform.h>
#include "carslow-layouts.dtsi"

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";

        wakeup-source;

        /*
         * ROW -> SWITCH -> DIODE -> COLUMN
         *
         * Para 1N4148:
         * faixa do diodo (catodo) voltada para a COLUMN.
         */
        diode-direction = "row2col";

        /*
         * ROWS
         *
         * Outputs da matriz.
         *
         * R0 = D0  / P0.08
         * R1 = D1  / P0.06
         * R2 = D4  / P0.22
         * R3 = D5  / P0.24
         * R4 = D6  / P1.00
         * R5 = D7  / P0.11
         * R6 = D10 / P0.09
         * R7 = D16 / P0.10
         */
        row-gpios
            = <&pro_micro 0  GPIO_ACTIVE_HIGH>
            , <&pro_micro 1  GPIO_ACTIVE_HIGH>
            , <&pro_micro 4  GPIO_ACTIVE_HIGH>
            , <&pro_micro 5  GPIO_ACTIVE_HIGH>
            , <&pro_micro 6  GPIO_ACTIVE_HIGH>
            , <&pro_micro 7  GPIO_ACTIVE_HIGH>
            , <&pro_micro 10 GPIO_ACTIVE_HIGH>
            , <&pro_micro 16 GPIO_ACTIVE_HIGH>
            ;

        /*
         * COLUMNS
         *
         * Inputs da matriz com pull-down.
         *
         * C0  = D8    / P1.04
         * C1  = D9    / P1.06
         * C2  = D14   / P1.11
         * C3  = D15   / P1.13
         * C4  = D18   / P1.15
         * C5  = D19   / P0.02
         * C6  = D20   / P0.29
         * C7  = D21   / P0.31
         * C8  = P1.01 / pad extra
         * C9  = P1.02 / pad extra
         * C10 = P1.07 / pad extra
         */
        col-gpios
            = <&pro_micro 8  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 9  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 18 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 1      (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 2      (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 7      (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };

    /*
     * A matriz elétrica possui:
     *
     *   8 rows × 11 columns = 88 posições
     *
     * Somente 87 posições são utilizadas.
     * RC(7,10) não existe fisicamente.
     *
     * A ordem deste map deve ser exatamente igual à ordem:
     *
     *   physical_layout0.keys
     *   carslow.keymap bindings
     */
    default_transform: keymap_transform {
        compatible = "zmk,matrix-transform";

        rows = <8>;
        columns = <11>;

        map = <
            /* 00..10 */
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)
            RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
            RC(0,10)

            /* 11..21 */
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)
            RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
            RC(1,10)

            /* 22..32 */
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)
            RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
            RC(2,10)

            /* 33..43 */
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4)
            RC(3,5) RC(3,6) RC(3,7) RC(3,8) RC(3,9)
            RC(3,10)

            /* 44..54 */
            RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4)
            RC(4,5) RC(4,6) RC(4,7) RC(4,8) RC(4,9)
            RC(4,10)

            /* 55..65 */
            RC(5,0) RC(5,1) RC(5,2) RC(5,3) RC(5,4)
            RC(5,5) RC(5,6) RC(5,7) RC(5,8) RC(5,9)
            RC(5,10)

            /* 66..76 */
            RC(6,0) RC(6,1) RC(6,2) RC(6,3) RC(6,4)
            RC(6,5) RC(6,6) RC(6,7) RC(6,8) RC(6,9)
            RC(6,10)

            /* 77..86 */
            RC(7,0) RC(7,1) RC(7,2) RC(7,3) RC(7,4)
            RC(7,5) RC(7,6) RC(7,7) RC(7,8) RC(7,9)
        >;
    };
};

/*
 * physical_layout0 é DECLARADO em carslow-layouts.dtsi.
 *
 * Aqui apenas ligamos esse layout físico ao matrix transform
 * usado pela matriz elétrica do CarSlow.
 */
&physical_layout0 {
    transform = <&default_transform>;
};
